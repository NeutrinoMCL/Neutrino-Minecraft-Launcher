import { LineEdit, ListView, Palette } from "std-widgets.slint";
import { ModalCard } from "../components/common.slint";
import { AccountFilter, AccountKind, SkinType } from "../models/enums.slint";
import { Actions } from "../state/actions.slint";
import { AppState } from "../state/app-state.slint";
import { MsaState, MsaStatus } from "../state/msa-state.slint";

component AccountMenuItem inherits Rectangle {
  in property <string> label;
  in property <image> icon;
  in property <bool> selected;

  callback clicked();

  height: 40px;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.14)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 8px;
    cross-axis-alignment: center;

    Image {
      source: root.icon;
      width: 16px;
      height: 16px;
      colorize: Palette.foreground.with-alpha(0.72);
    }

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 13px;
      font-weight: root.selected ? 600 : 400;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component LoginButton inherits Rectangle {
  in property <string> label;
  in property <bool> enabled: true;

  callback clicked();

  height: 32px;
  border-radius: 6px;
  opacity: root.enabled ? 1 : 0.5;
  background: touch.has-hover && root.enabled
    ? Palette.accent-background.with-alpha(0.2)
    : Palette.accent-background.with-alpha(0.14);

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    alignment: center;
    cross-axis-alignment: center;

    Text {
      text: root.label;
      color: Palette.accent-background;
      font-size: 12px;
      font-weight: 600;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    enabled: root.enabled;
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component DialogButton inherits Rectangle {
  in property <string> label;
  in property <bool> primary: false;

  callback clicked();

  height: 32px;
  horizontal-stretch: 0;
  border-radius: 6px;
  background: root.primary
    ? touch.has-hover
      ? Palette.accent-background.with-alpha(0.24)
      : Palette.accent-background.with-alpha(0.16)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.08)
      : Palette.foreground.with-alpha(0.04);
  border-width: 1px;
  border-color: root.primary ? transparent : Palette.foreground.with-alpha(0.12);

  HorizontalLayout {
    padding-left: 14px;
    padding-right: 14px;
    alignment: center;
    cross-axis-alignment: center;

    Text {
      text: root.label;
      color: root.primary ? Palette.accent-background : Palette.foreground;
      font-size: 12px;
      font-weight: 600;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component AccountCard inherits Rectangle {
  in property <string> name;
  in property <bool> active;
  in property <SkinType> skin;
  in property <image> avatar;
  in property <AccountKind> kind;

  callback activate();
  callback remove();
  callback manage-skin();

  height: 62px;
  border-radius: 6px;
  background: root.active
    ? Palette.accent-background.with-alpha(0.12)
    : activate-touch.has-hover
      ? Palette.foreground.with-alpha(0.04)
      : Palette.background.with-alpha(0.5);
  border-width: 1px;
  border-color: root.active
    ? Palette.accent-background.with-alpha(0.45)
    : Palette.foreground.with-alpha(0.08);

  activate-touch := TouchArea {
    x: 0;
    y: 0;
    width: parent.width - 92px;
    height: parent.height;
    mouse-cursor: pointer;
    clicked => {
      root.activate();
    }
  }

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 8px;
    spacing: 12px;
    cross-axis-alignment: center;

    Rectangle {
      width: 36px;
      height: 36px;
      border-radius: 6px;
      clip: true;
      background: Palette.accent-background.with-alpha(0.14);

      Image {
        source: root.skin == SkinType.steve
          ? @image-url("../images/faces/steve.png")
          : root.skin == SkinType.alex
            ? @image-url("../images/faces/alex.png")
            : root.avatar;
        width: 100%;
        height: 100%;
      }
    }

    VerticalLayout {
      horizontal-stretch: 1;
      alignment: center;
      spacing: 2px;

      HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;

        Text {
          text: root.name;
          color: Palette.foreground;
          font-size: 13px;
          font-weight: 600;
          horizontal-stretch: 1;
          vertical-alignment: center;
          overflow: elide;
        }

        if root.active : Rectangle {
          height: 18px;
          border-radius: 4px;
          background: Palette.accent-background.with-alpha(0.16);

          HorizontalLayout {
            padding-left: 5px;
            padding-right: 5px;
            alignment: center;
            cross-axis-alignment: center;

            Text {
              text: "使用中";
              color: Palette.accent-background;
              font-size: 10px;
              font-weight: 600;
              vertical-alignment: center;
            }
          }
        }
      }

      Text {
        text: root.kind == AccountKind.microsoft ? "Microsoft 账号" : "离线账号";
        color: Palette.foreground.with-alpha(0.5);
        font-size: 11px;
      }
    }

    Rectangle {
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: remove-touch.has-hover
        ? #c0392b22
        : transparent;

      Image {
        source: @image-url("../images/icons/trash.svg");
        width: 15px;
        height: 15px;
        colorize: remove-touch.has-hover
          ? #c0392b
          : Palette.foreground.with-alpha(0.42);
      }

      remove-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
          root.remove();
        }
      }
    }

    Rectangle {
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: brush-touch.has-hover
        ? Palette.foreground.with-alpha(0.08)
        : transparent;

      Image {
        source: @image-url("../images/icons/brush.svg");
        width: 15px;
        height: 15px;
        colorize: brush-touch.has-hover
          ? Palette.foreground
          : Palette.foreground.with-alpha(0.55);
      }

      brush-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
          root.manage-skin();
        }
      }
    }
  }
}

component SkinOptionRow inherits Rectangle {
  in property <string> label;
  in property <bool> selected;

  callback clicked();

  height: 40px;
  horizontal-stretch: 1;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.12)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;
  border-width: 1px;
  border-color: root.selected
    ? Palette.accent-background.with-alpha(0.45)
    : Palette.foreground.with-alpha(0.08);

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 10px;
    cross-axis-alignment: center;

    Rectangle {
      width: 14px;
      height: 14px;
      border-radius: 7px;
      border-width: 1px;
      border-color: root.selected
        ? Palette.accent-background
        : Palette.foreground.with-alpha(0.4);

      if root.selected : Rectangle {
        x: 3px;
        y: 3px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Palette.accent-background;
      }
    }

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 13px;
      horizontal-stretch: 1;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component SkinDialog inherits Rectangle {
  in property <string> account;

  callback cancel();

  background: transparent;

  ModalCard {
    card-width: 640px;
    card-height: 440px;
    close => {
      root.cancel();
    }

    VerticalLayout {
      padding: 20px;
      spacing: 12px;

      Text {
        text: "管理皮肤 · " + root.account;
        color: Palette.foreground;
        font-size: 18px;
        font-weight: 600;
      }

      HorizontalLayout {
        spacing: 20px;
        vertical-stretch: 1;
        cross-axis-alignment: center;

        // 3D 预览（wgpu 离屏渲染，纹理直接导入成 image）
        Rectangle {
          width: 280px;
          height: 280px;
          horizontal-stretch: 0;
          vertical-stretch: 0;
          border-radius: 8px;
          background: Palette.background.with-alpha(0.5);
          border-width: 1px;
          border-color: Palette.foreground.with-alpha(0.12);
          clip: true;

          Image {
            source: AppState.preview-image;
            width: 100%;
            height: 100%;
            image-fit: contain;
          }

          if !AppState.preview-ready : Text {
            text: "3D 预览不可用";
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.4);
            font-size: 12px;
          }

          Text {
            text: "拖动旋转";
            width: 100%;
            y: parent.height - self.height - 10px;
            horizontal-alignment: center;
            color: Palette.foreground.with-alpha(0.55);
            font-size: 11px;
          }

          skin-preview-touch := TouchArea {
            mouse-cursor: pointer;

            changed pressed => {
              if (self.pressed) {
                Actions.preview-orbit-start();
              }
            }

            moved => {
              Actions.preview-orbit(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
          }
        }

        // 只把当前账号的选项放进布局：隐藏账号的列如果还参与布局，会把第 2 / 第 3 个
        // 账号的选项推到右边，甚至挤出弹窗。
        Rectangle {
          horizontal-stretch: 1;
          vertical-stretch: 0;
          height: 132px;
          background: transparent;

          for account in AppState.accounts : VerticalLayout {
            visible: account.name == root.account;
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            spacing: 6px;

            SkinOptionRow {
              label: "Steve（默认）";
              selected: account.skin == SkinType.steve;
              clicked => {
                Actions.set-default-skin(root.account, SkinType.steve);
                Actions.preview-skin(root.account, Palette.background.red > 128);
              }
            }

            SkinOptionRow {
              label: "Alex（默认）";
              selected: account.skin == SkinType.alex;
              clicked => {
                Actions.set-default-skin(root.account, SkinType.alex);
                Actions.preview-skin(root.account, Palette.background.red > 128);
              }
            }

            SkinOptionRow {
              label: "自定义皮肤";
              selected: account.skin == SkinType.custom;
              clicked => {
                Actions.choose-custom-skin(root.account);
                Actions.preview-skin(root.account, Palette.background.red > 128);
              }
            }
          }
        }
      }

      Text {
        text: "自定义皮肤请选择 64×64 或 128×128 的 PNG 文件。";
        color: Palette.foreground.with-alpha(0.5);
        font-size: 11px;
        wrap: word-wrap;
      }

      Rectangle {
        vertical-stretch: 1;
      }

      HorizontalLayout {
        alignment: end;

        DialogButton {
          label: "关闭";
          clicked => {
            root.cancel();
          }
        }
      }
    }
  }

  init => {
    Actions.preview-skin(root.account, Palette.background.red > 128);
  }
}

component AddAccountDialog inherits Rectangle {
  in-out property <string> name;
  in-out property <string> error;

  callback cancel();
  callback submit();

  background: transparent;

  ModalCard {
    card-width: 380px;
    card-height: 232px;
    close => {
      root.cancel();
    }

    VerticalLayout {
      padding: 20px;
      spacing: 10px;

      Text {
        text: "添加离线角色";
        color: Palette.foreground;
        font-size: 18px;
        font-weight: 600;
      }

      Text {
        text: "离线角色保存在本地，无需登录 Microsoft 账号。";
        color: Palette.foreground.with-alpha(0.65);
        font-size: 12px;
        wrap: word-wrap;
      }

      LineEdit {
        placeholder-text: "角色名（3-16 位字母、数字或下划线）";
        text <=> root.name;
        edited => {
          root.error = "";
        }
        accepted => {
          root.submit();
        }
        init => {
          self.focus();
        }
      }

      if root.error != "" : Text {
        text: root.error;
        color: #e74c3c;
        font-size: 12px;
        wrap: word-wrap;
      }

      Rectangle {
        vertical-stretch: 1;
      }

      HorizontalLayout {
        alignment: end;
        spacing: 8px;

        DialogButton {
          label: "取消";
          clicked => {
            root.cancel();
          }
        }

        DialogButton {
          label: "添加角色";
          primary: true;
          clicked => {
            root.submit();
          }
        }
      }
    }
  }
}

component MicrosoftLoginPanel inherits Rectangle {
  background: transparent;

  pure function status-text() -> string {
    if (MsaState.status == MsaStatus.starting) {
      return "正在启动登录...";
    }
    if (MsaState.status == MsaStatus.waiting) {
      return "等待浏览器完成授权";
    }
    if (MsaState.status == MsaStatus.success) {
      return "登录成功";
    }
    if (MsaState.status == MsaStatus.missing-client-id) {
      return "需要配置客户端 ID";
    }
    if (MsaState.status == MsaStatus.error) {
      return "登录失败";
    }
    return "尚未登录";
  }

  pure function button-label() -> string {
    if (MsaState.status == MsaStatus.waiting) {
      return "打开浏览器";
    }
    if (MsaState.status == MsaStatus.success) {
      return "重新登录";
    }
    if (MsaState.status == MsaStatus.starting) {
      return "登录中...";
    }
    return "登录";
  }

  VerticalLayout {
    spacing: 10px;

    Rectangle {
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);

      VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
          spacing: 12px;
          cross-axis-alignment: center;

          Image {
            source: @image-url("../images/icons/microsoft.svg");
            width: 24px;
            height: 24px;
            colorize: Palette.foreground.with-alpha(0.72);
          }

          VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Text {
              text: "Microsoft 登录";
              color: Palette.foreground;
              font-size: 13px;
              font-weight: 600;
            }

            Text {
              text: root.status-text();
              color: Palette.foreground.with-alpha(0.65);
              font-size: 12px;
            }
          }

          LoginButton {
            label: root.button-label();
            enabled: MsaState.status != MsaStatus.starting;
            clicked => {
              if MsaState.status == MsaStatus.waiting {
                Actions.open-url(MsaState.verification-uri);
              } else {
                Actions.start-microsoft-login();
              }
            }
          }
        }

        if MsaState.status == MsaStatus.waiting : VerticalLayout {
          spacing: 4px;

          Text {
            text: "在浏览器中输入以下代码：";
            color: Palette.foreground.with-alpha(0.65);
            font-size: 12px;
          }

          Text {
            text: MsaState.user-code;
            color: Palette.foreground;
            font-size: 26px;
            font-weight: 700;
          }

          Text {
            text: MsaState.verification-uri;
            color: Palette.accent-background;
            font-size: 11px;
            overflow: elide;
          }
        }

        if MsaState.status == MsaStatus.success : Text {
          text: "已登录：" + MsaState.player-name;
          color: Palette.foreground;
          font-size: 13px;
          font-weight: 600;
        }

        if MsaState.status == MsaStatus.error : Text {
          text: MsaState.error;
          color: #c0392b;
          font-size: 12px;
        }

        if MsaState.status == MsaStatus.missing-client-id : VerticalLayout {
          spacing: 2px;

          Text {
            text: "未配置 Microsoft 客户端 ID";
            color: #c0392b;
            font-size: 12px;
          }

          Text {
            text: "请设置环境变量 NEUTRINO_MSA_CLIENT_ID";
            color: Palette.foreground.with-alpha(0.65);
            font-size: 11px;
          }
        }
      }
    }

    Rectangle {
      vertical-stretch: 1;
    }
  }
}

component AccountListPanel inherits Rectangle {
  background: transparent;

  callback manage-skin(string);

  VerticalLayout {
    spacing: 8px;

    if AppState.accounts.length == 0 : Rectangle {
      height: 112px;
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);

      VerticalLayout {
        alignment: center;
        spacing: 6px;

        Image {
          source: @image-url("../images/icons/offline.svg");
          width: 24px;
          height: 24px;
          colorize: Palette.foreground.with-alpha(0.3);
        }

        Text {
          text: "暂无角色";
          color: Palette.foreground.with-alpha(0.55);
          font-size: 13px;
          horizontal-alignment: center;
        }

        Text {
          text: "点击右上角的 + 添加一个离线角色";
          color: Palette.foreground.with-alpha(0.38);
          font-size: 12px;
          horizontal-alignment: center;
        }
      }
    }

    if AppState.accounts.length > 0 : ListView {
      vertical-stretch: 1;

      for account in AppState.accounts : AccountCard {
        name: account.name;
        skin: account.skin;
        avatar: account.avatar;
        kind: account.kind;
        active: AppState.active-account == account.name;
        activate => {
          Actions.set-active-account(account.name);
        }
        remove => {
          Actions.remove-account(account.name);
        }
        manage-skin => {
          root.manage-skin(account.name);
        }
      }
    }

    if AppState.accounts.length == 0 : Rectangle {
      vertical-stretch: 1;
    }
  }
}

export component AccountView inherits Rectangle {
  in-out property <AccountFilter> current-filter: AccountFilter.all;
  in-out property <bool> show-add-dialog: false;
  in-out property <string> new-account-name: "";
  in-out property <string> add-error: "";
  in-out property <bool> show-skin-dialog: false;
  in-out property <string> skin-dialog-account: "";

  background: transparent;

  pure function filter-title() -> string {
    if (root.current-filter == AccountFilter.microsoft) {
      return "微软账号";
    }
    if (root.current-filter == AccountFilter.offline) {
      return "离线角色";
    }
    return "全部角色";
  }

  pure function filter-subtitle() -> string {
    if (root.current-filter == AccountFilter.microsoft) {
      return "使用 Microsoft 账号登录 Minecraft";
    }
    if (root.current-filter == AccountFilter.offline) {
      return "本地角色，无需网络验证";
    }
    return "管理启动器中的所有角色";
  }

  function open-add-dialog() {
    root.new-account-name = "";
    root.add-error = "";
    root.show-add-dialog = true;
  }

  function open-skin-dialog(name: string) {
    root.skin-dialog-account = name;
    root.show-skin-dialog = true;
    Actions.preview-skin(name, Palette.background.red > 128);
  }

  function submit-new-account() {
    if (root.new-account-name.is-empty) {
      root.add-error = "请输入角色名";
      return;
    }

    root.add-error = Actions.add-offline-account(root.new-account-name);
    if (root.add-error.is-empty) {
      root.new-account-name = "";
      root.show-add-dialog = false;

      if (root.current-filter == AccountFilter.microsoft) {
        root.current-filter = AccountFilter.offline;
      }
    }
  }

  HorizontalLayout {
    padding: 16px;
    spacing: 16px;

    VerticalLayout {
      width: 200px;
      horizontal-stretch: 0;
      padding-top: 8px;
      padding-bottom: 8px;
      spacing: 4px;

      AccountMenuItem {
        label: "全部来源";
        icon: @image-url("../images/icons/people.svg");
        selected: root.current-filter == AccountFilter.all;
        clicked => {
          root.current-filter = AccountFilter.all;
        }
      }

      AccountMenuItem {
        label: "微软账号";
        icon: @image-url("../images/icons/microsoft.svg");
        selected: root.current-filter == AccountFilter.microsoft;
        clicked => {
          root.current-filter = AccountFilter.microsoft;
        }
      }

      AccountMenuItem {
        label: "离线账号";
        icon: @image-url("../images/icons/offline.svg");
        selected: root.current-filter == AccountFilter.offline;
        clicked => {
          root.current-filter = AccountFilter.offline;
        }
      }
    }

    Rectangle {
      horizontal-stretch: 1;
      background: transparent;

      VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
          spacing: 8px;
          cross-axis-alignment: start;

          VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
              text: root.filter-title();
              color: Palette.foreground;
              font-size: 18px;
              font-weight: 600;
            }

            Text {
              text: root.filter-subtitle();
              color: Palette.foreground.with-alpha(0.65);
              font-size: 13px;
            }
          }

          Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 6px;
            background: plus-touch.has-hover
              ? Palette.accent-background.with-alpha(0.24)
              : Palette.accent-background.with-alpha(0.14);

            Image {
              source: @image-url("../images/icons/plus.svg");
              width: 16px;
              height: 16px;
              colorize: Palette.accent-background;
            }

            plus-touch := TouchArea {
              mouse-cursor: pointer;
              clicked => {
                root.open-add-dialog();
              }
            }
          }
        }

        if root.current-filter == AccountFilter.microsoft : MicrosoftLoginPanel {
          vertical-stretch: 1;
        }

        if root.current-filter != AccountFilter.microsoft : AccountListPanel {
          vertical-stretch: 1;
          manage-skin(name) => {
            root.open-skin-dialog(name);
          }
        }
      }
    }
  }

  if root.show-add-dialog : AddAccountDialog {
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    name <=> root.new-account-name;
    error <=> root.add-error;

    cancel => {
      root.show-add-dialog = false;
    }

    submit => {
      root.submit-new-account();
    }
  }

  if root.show-skin-dialog : SkinDialog {
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    account: root.skin-dialog-account;

    cancel => {
      root.show-skin-dialog = false;
    }
  }
}
