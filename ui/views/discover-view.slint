import { ComboBox, LineEdit, ListView, Palette } from "std-widgets.slint";
import { EmptyHint, ListPanel, MessageStrip, RefreshButton, Tag } from "../components/common.slint";
import { AppState } from "../state/app-state.slint";
import { Actions } from "../state/actions.slint";

// 侧栏类别项，与实例页 / 账户页 / 设置页保持同一套视觉
component CategoryItem inherits Rectangle {
  in property <string> label;
  in property <image> icon;
  in property <bool> selected;

  callback clicked();

  height: 40px;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.14)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 8px;
    cross-axis-alignment: center;

    Image {
      source: root.icon;
      width: 16px;
      height: 16px;
      colorize: Palette.foreground.with-alpha(0.72);
    }

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 14px;
      font-weight: root.selected ? 600 : 400;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

// 筛选项标签，保持紧凑
component FilterLabel inherits Text {
  color: Palette.foreground.with-alpha(0.6);
  font-size: 12px;
  vertical-alignment: center;
  horizontal-stretch: 0;
}

// 项目信息里的蓝色标签：客户端/服务端、分类、加载器
component ProjectTag inherits Tag {
  corner-radius: 4px;
}

// 项目图标；没有图标时回退到首字母头像
component ProjectAvatar inherits Rectangle {
  in property <image> icon;
  in property <bool> has-icon;
  in property <string> initial;
  in property <length> avatar-size: 48px;

  width: root.avatar-size;
  height: root.avatar-size;
  border-radius: 6px;
  clip: true;
  background: Palette.accent-background.with-alpha(0.16);

  if root.has-icon : Image {
    source: root.icon;
    width: 100%;
    height: 100%;
    image-fit: contain;
  }

  if !root.has-icon : Text {
    text: root.initial;
    color: Palette.accent-background;
    font-size: root.avatar-size * 0.42;
    font-weight: 700;
    horizontal-alignment: center;
    vertical-alignment: center;
  }
}

// 项目列表行：整块可点击，进入版本选择
component ProjectRow inherits Rectangle {
  in property <string> title;
  in property <string> initial;
  in property <image> icon;
  in property <bool> has-icon;
  in property <string> subtitle;
  in property <string> description;
  in property <[string]> tags;

  callback open();

  height: 96px;
  background: transparent;

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.open();
    }
  }

  card := Rectangle {
    x: 0;
    y: 4px;
    width: 100%;
    height: 88px;
    border-radius: 6px;
    background: touch.has-hover
      ? Palette.foreground.with-alpha(0.10)
      : Palette.foreground.with-alpha(0.05);
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.12);

    HorizontalLayout {
      padding-left: 12px;
      padding-right: 12px;
      spacing: 10px;
      cross-axis-alignment: center;

      ProjectAvatar {
        icon: root.icon;
        has-icon: root.has-icon;
        initial: root.initial;
      }

      VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 4px;

        FlexboxLayout {
          spacing: 6px;
          cross-axis-alignment: center;

          Text {
            text: root.title;
            color: Palette.foreground;
            font-size: 15px;
            font-weight: 600;
            max-width: 260px;
            vertical-alignment: center;
            overflow: elide;
          }

          for tag in root.tags : ProjectTag {
            label: tag;
          }
        }

        Text {
          text: root.description;
          color: Palette.foreground.with-alpha(0.62);
          font-size: 12px;
          max-lines: 1;
          overflow: elide;
        }

        Text {
          text: root.subtitle;
          color: Palette.foreground.with-alpha(0.42);
          font-size: 12px;
          overflow: elide;
        }
      }

      Rectangle {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        background: touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;

        Image {
          source: @image-url("../images/icons/arrow-right.svg");
          width: 16px;
          height: 16px;
          colorize: Palette.foreground.with-alpha(0.55);
        }
      }
    }
  }
}

// 版本选择行：显示游戏版本 / 加载器 / 发布通道，并单独下载
component ProjectVersionRow inherits Rectangle {
  in property <string> title;
  in property <[string]> loaders;
  in property <string> channel;
  in property <string> file-name;
  in property <string> file-size;
  in property <bool> downloadable;
  in property <bool> busy;
  in property <bool> active;

  callback download();

  height: 88px;
  background: transparent;

  Rectangle {
    x: 0;
    y: 4px;
    width: 100%;
    height: 80px;
    border-radius: 6px;
    background: Palette.foreground.with-alpha(0.05);
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.12);

    HorizontalLayout {
      padding-left: 14px;
      padding-right: 10px;
      spacing: 10px;
      cross-axis-alignment: center;

      VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 4px;

        HorizontalLayout {
          spacing: 8px;
          cross-axis-alignment: center;

          FlexboxLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            cross-axis-alignment: center;

            Text {
              text: root.title;
              color: Palette.foreground;
              font-size: 14px;
              font-weight: 600;
              overflow: elide;
              vertical-alignment: center;
            }

            for loader in root.loaders : ProjectTag {
              label: loader;
            }
          }

          Rectangle {
            height: 20px;
            min-width: 48px;
            horizontal-stretch: 0;
            border-radius: 6px;
            background: root.channel == "正式版"
              ? Palette.accent-background.with-alpha(0.14)
              : Palette.foreground.with-alpha(0.08);

            HorizontalLayout {
              padding-left: 6px;
              padding-right: 6px;
              alignment: center;
              cross-axis-alignment: center;

              Text {
                text: root.channel;
                color: root.channel == "正式版"
                  ? Palette.accent-background
                  : Palette.foreground.with-alpha(0.6);
                font-size: 11px;
                vertical-alignment: center;
              }
            }
          }
        }

        Text {
          text: root.file-name + " · " + root.file-size;
          color: Palette.foreground.with-alpha(0.42);
          font-size: 11px;
          overflow: elide;
        }
      }

      Rectangle {
        height: 32px;
        min-width: 84px;
        horizontal-stretch: 0;
        border-radius: 6px;
        opacity: !root.downloadable || (root.busy && !root.active) ? 0.4 : 1.0;
        border-width: 1px;
        border-color: Palette.accent-background.with-alpha(0.55);
        background: download-touch.has-hover && root.downloadable && !root.busy
          ? Palette.accent-background.with-alpha(0.30)
          : Palette.accent-background.with-alpha(0.18);

        HorizontalLayout {
          padding-left: 12px;
          padding-right: 12px;
          alignment: center;
          cross-axis-alignment: center;

          Text {
            text: root.active ? "下载中…" : root.downloadable ? "下载" : "不可下载";
            color: Palette.accent-background;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
          }
        }

        download-touch := TouchArea {
          mouse-cursor: pointer;
          clicked => {
            if (root.downloadable && !root.busy) {
              root.download();
            }
          }
        }
      }
    }
  }
}

// 提示条
export component DiscoverView inherits Rectangle {
  background: transparent;

  // 筛选 ComboBox 的当前项；切换类别 / 下载源时重置到“全部”。
  in-out property <int> loader-index: 0;
  in-out property <int> category-index: 0;
  in-out property <int> sort-index: 0;
  in-out property <string> search-input: "";

  init => {
    root.search-input = AppState.discover-query;
  }

  // 从实例下载弹窗打开时会清空搜索词，同步清空两个 DiscoverView 实例的输入框。
  property <string> synced-query: AppState.discover-query;
  changed synced-query => {
    root.search-input = synced-query;
  }

  function run-search() {
    Actions.search-projects(root.search-input);
  }

  function clear-search() {
    root.search-input = "";
    Actions.search-projects("");
  }

  function source-name() -> string {
    return AppState.discover-source == "curseforge" ? "CurseForge" : "Modrinth";
  }

  function category-title() -> string {
    if (AppState.category == "mod") {
      return "模组";
    }
    if (AppState.category == "shader") {
      return "光影包";
    }
    if (AppState.category == "resourcepack") {
      return "材质包";
    }
    return "整合包";
  }

  function category-subtitle() -> string {
    if (AppState.category == "mod") {
      return "来自 " + root.source-name() + " 的热门模组，下载到 mods/ 目录（需先装好 Fabric / Forge 等加载器）";
    }
    if (AppState.category == "shader") {
      return "光影包会下载到 shaderpacks/ 目录，游戏内需配合 Iris 或 OptiFine 使用";
    }
    if (AppState.category == "resourcepack") {
      return "材质包会下载到 resourcepacks/ 目录";
    }
    return "整合包列表来自 " + root.source-name() + "，一键安装仍在开发中";
  }

  HorizontalLayout {
    padding: 16px;
    spacing: 16px;

    // 左侧类别
    VerticalLayout {
      width: 200px;
      horizontal-stretch: 0;
      padding-top: 8px;
      padding-bottom: 8px;
      spacing: 4px;

      CategoryItem {
        label: "模组";
        icon: @image-url("../images/icons/mod.svg");
        selected: AppState.category == "mod";
        clicked => {
          root.loader-index = 0;
          root.category-index = 0;
          Actions.open-category("mod");
        }
      }

      CategoryItem {
        label: "光影包";
        icon: @image-url("../images/icons/shader.svg");
        selected: AppState.category == "shader";
        clicked => {
          root.loader-index = 0;
          root.category-index = 0;
          Actions.open-category("shader");
        }
      }

      CategoryItem {
        label: "资源包";
        icon: @image-url("../images/icons/resource.svg");
        selected: AppState.category == "resourcepack";
        clicked => {
          root.loader-index = 0;
          root.category-index = 0;
          Actions.open-category("resourcepack");
        }
      }

      CategoryItem {
        label: "整合包";
        icon: @image-url("../images/icons/boxes.svg");
        selected: AppState.category == "modpack";
        clicked => {
          root.loader-index = 0;
          root.category-index = 0;
          Actions.open-category("modpack");
        }
      }

      Rectangle {
        vertical-stretch: 1;
      }

      if !AppState.project-open && AppState.projects-summary != "" : Text {
        text: AppState.projects-summary;
        color: Palette.foreground.with-alpha(0.45);
        font-size: 11px;
        wrap: word-wrap;
      }
    }

    // 右侧内容
    VerticalLayout {
      spacing: 10px;
      padding: 16px;

      if !AppState.project-open : HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
          horizontal-stretch: 1;
          alignment: center;
          spacing: 2px;

          Text {
            text: root.category-title();
            color: Palette.foreground;
            font-size: 20px;
            font-weight: 600;
          }

          Text {
            text: root.category-subtitle();
            color: Palette.foreground.with-alpha(0.65);
            font-size: 14px;
            overflow: elide;
          }
        }

        // 排序
        HorizontalLayout {
          spacing: 4px;
          horizontal-stretch: 0;
          cross-axis-alignment: center;

          FilterLabel {
            text: "排序";
          }

          ComboBox {
            model: AppState.sort-options;
            current-index <=> root.sort-index;
            width: 130px;
            horizontal-stretch: 0;
            selected(value) => {
              Actions.choose-sort(value);
            }
          }
        }

        // 刷新按钮
        RefreshButton {
          loading: AppState.projects-loading;
          clicked => {
            Actions.open-category(AppState.category);
          }
        }
      }

      // 搜索
      if !AppState.project-open : HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;

        LineEdit {
          text <=> root.search-input;
          placeholder-text: "搜索" + root.category-title() + "…";
          height: 32px;
          horizontal-stretch: 1;
          edited(value) => {
            if (value.is-empty && !AppState.discover-query.is-empty) {
              root.clear-search();
            }
          }
          accepted => {
            root.run-search();
          }
        }

        Rectangle {
          height: 32px;
          min-width: 64px;
          horizontal-stretch: 0;
          border-radius: 6px;
          border-width: 1px;
          border-color: Palette.accent-background.with-alpha(0.55);
          background: search-touch.has-hover
            ? Palette.accent-background.with-alpha(0.30)
            : Palette.accent-background.with-alpha(0.18);

          Text {
            text: "搜索";
            color: Palette.accent-background;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
          }

          search-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
              root.run-search();
            }
          }
        }

        if AppState.discover-query != "" : Rectangle {
          height: 32px;
          min-width: 52px;
          horizontal-stretch: 0;
          border-radius: 6px;
          background: clear-search-touch.has-hover
            ? Palette.foreground.with-alpha(0.06)
            : transparent;

          Text {
            text: "清除";
            color: Palette.foreground.with-alpha(0.6);
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
          }

          clear-search-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
              root.clear-search();
            }
          }
        }
      }

      // 筛选：下载源 / 加载器 / 游戏版本 / 分类
      if !AppState.project-open : HorizontalLayout {
        spacing: 5px;
        cross-axis-alignment: center;

        HorizontalLayout {
          spacing: 4px;
          horizontal-stretch: 0;
          cross-axis-alignment: center;

          FilterLabel {
            text: "下载源";
          }

          ComboBox {
            model: ["Modrinth", "CurseForge"];
            width: 120px;
            horizontal-stretch: 0;
            selected(value) => {
              root.loader-index = 0;
              root.category-index = 0;
              root.sort-index = 0;
              Actions.choose-source(value == "CurseForge" ? "curseforge" : "modrinth");
            }
          }
        }

        if AppState.loader-options.length > 1 : HorizontalLayout {
          spacing: 4px;
          horizontal-stretch: 0;
          cross-axis-alignment: center;

          FilterLabel {
            text: "加载器";
          }

          ComboBox {
            model: AppState.loader-options;
            current-index <=> root.loader-index;
            enabled: !(AppState.discover-source == "curseforge"
              && AppState.selected-game-version == "");
            width: 130px;
            horizontal-stretch: 0;
            selected(value) => {
              Actions.choose-loader-filter(value);
            }
          }
        }

        HorizontalLayout {
          spacing: 4px;
          horizontal-stretch: 0;
          cross-axis-alignment: center;

          FilterLabel {
            text: "版本";
          }

          ComboBox {
            model: AppState.game-versions;
            width: 145px;
            horizontal-stretch: 0;
            selected(value) => {
              if (AppState.discover-source == "curseforge" && value == "全部版本") {
                root.loader-index = 0;
              }
              Actions.choose-game-version(value);
            }
          }
        }

        HorizontalLayout {
          spacing: 4px;
          horizontal-stretch: 0;
          cross-axis-alignment: center;

          FilterLabel {
            text: "分类";
          }

          ComboBox {
            model: AppState.category-options;
            current-index <=> root.category-index;
            width: 180px;
            horizontal-stretch: 0;
            selected(value) => {
              Actions.choose-category-filter(value);
            }
          }
        }

        Rectangle {
          horizontal-stretch: 1;
        }
      }

      // 项目详情头部
      if AppState.project-open : HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        Rectangle {
          height: 30px;
          min-width: 64px;
          horizontal-stretch: 0;
          border-radius: 6px;
          background: back-touch.has-hover
            ? Palette.foreground.with-alpha(0.06)
            : transparent;

          HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: center;
            cross-axis-alignment: center;

            Text {
              text: "← 返回";
              color: Palette.foreground;
              font-size: 12px;
              vertical-alignment: center;
            }
          }

          back-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
              Actions.close-project();
            }
          }
        }

        ProjectAvatar {
          icon: AppState.project-icon;
          has-icon: AppState.project-has-icon;
          initial: AppState.project-initial;
          avatar-size: 56px;
        }

        VerticalLayout {
          horizontal-stretch: 1;
          alignment: center;
          spacing: 2px;

          FlexboxLayout {
            spacing: 6px;
            cross-axis-alignment: center;

            Text {
              text: AppState.project-title;
              color: Palette.foreground;
              font-size: 20px;
              font-weight: 600;
              max-width: 420px;
              vertical-alignment: center;
              overflow: elide;
            }

            for tag in AppState.project-tags : ProjectTag {
              label: tag;
            }
          }

          Text {
            text: AppState.project-subtitle;
            color: Palette.foreground.with-alpha(0.55);
            font-size: 12px;
            overflow: elide;
          }

          Text {
            text: AppState.project-description;
            color: Palette.foreground.with-alpha(0.65);
            font-size: 12px;
            max-lines: 1;
            overflow: elide;
          }
        }
      }

      if AppState.download-message != "" : MessageStrip {
        message: AppState.download-message;
        ok: AppState.download-ok;
      }

      if !AppState.project-open && AppState.projects-error != "" : MessageStrip {
        message: AppState.projects-error;
        ok: false;
      }

      if AppState.project-open && AppState.project-versions-error != "" : MessageStrip {
        message: AppState.project-versions-error;
        ok: false;
      }

      // 项目列表
      if !AppState.project-open : ListPanel {
        vertical-stretch: 1;

        ListView {
          x: 0;
          y: 0;
          width: 100%;
          height: 100%;

          for project in AppState.projects : ProjectRow {
            title: project.title;
            initial: project.initial;
            icon: project.icon;
            has-icon: project.has-icon;
            subtitle: project.subtitle;
            description: project.description;
            tags: project.tags;
            open => {
              Actions.open-project(project.project-id);
            }
          }
        }

        if AppState.projects.length == 0 : EmptyHint {
          text: AppState.projects-loading
            ? "正在从 " + root.source-name() + " 获取列表…"
            : "没有获取到项目，点右上角刷新试试";
        }
      }

      // 版本选择
      if AppState.project-open : ListPanel {
        vertical-stretch: 1;

        if AppState.has-recommended-version : Rectangle {
          x: 8px;
          y: 8px;
          width: parent.width - 16px;
          height: 86px;
          border-radius: 6px;
          background: Palette.accent-background.with-alpha(0.10);
          border-width: 1px;
          border-color: Palette.accent-background.with-alpha(0.35);

          HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            cross-axis-alignment: center;

            VerticalLayout {
              horizontal-stretch: 1;
              alignment: center;
              spacing: 3px;

              HorizontalLayout {
                spacing: 6px;
                alignment: start;
                cross-axis-alignment: center;

                ProjectTag {
                  label: "推荐版本";
                }

                Text {
                  text: AppState.recommended-version.name;
                  color: Palette.foreground;
                  font-size: 14px;
                  font-weight: 600;
                  overflow: elide;
                }

                for loader in AppState.recommended-version.loaders : ProjectTag {
                  label: loader;
                }
              }

              Text {
                text: "游戏版本 " + AppState.recommended-version.game-versions
                  + " · " + AppState.recommended-version.file-name
                  + " · " + AppState.recommended-version.size;
                color: Palette.foreground.with-alpha(0.55);
                font-size: 11px;
                overflow: elide;
              }
            }

            Rectangle {
              height: 32px;
              min-width: 84px;
              horizontal-stretch: 0;
              border-radius: 6px;
              opacity: AppState.downloading-version != ""
                && AppState.downloading-version != AppState.recommended-version.key
                ? 0.4
                : 1.0;
              border-width: 1px;
              border-color: Palette.accent-background.with-alpha(0.55);
              background: rec-download-touch.has-hover && AppState.downloading-version == ""
                ? Palette.accent-background.with-alpha(0.30)
                : Palette.accent-background.with-alpha(0.18);

              Text {
                text: AppState.downloading-version == AppState.recommended-version.key
                  ? "下载中…"
                  : "下载";
                color: Palette.accent-background;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
              }

              rec-download-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                  if (AppState.downloading-version == "") {
                    Actions.download-version(AppState.recommended-version.key);
                  }
                }
              }
            }
          }
        }

        ListView {
          x: 0;
          y: AppState.has-recommended-version ? 100px : 0;
          width: 100%;
          height: AppState.has-recommended-version ? parent.height - 100px : parent.height;

          for group in AppState.project-version-groups : VerticalLayout {
            // 每个游戏版本分组独立记住折叠状态；重新打开项目时模型清空，状态随之重置。
            property <bool> collapsed: true;

            Rectangle {
              height: 40px;
              border-radius: 6px;
              background: header-touch.has-hover
                ? Palette.foreground.with-alpha(0.04)
                : transparent;

              HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: end;

                Image {
                  source: @image-url("../images/icons/arrow-right.svg");
                  width: 12px;
                  height: 12px;
                  colorize: Palette.foreground.with-alpha(0.45);
                  transform-rotation: collapsed ? 0deg : 90deg;
                }

                Text {
                  text: group.game-version;
                  color: Palette.foreground;
                  font-size: 15px;
                  font-weight: 700;
                  vertical-alignment: bottom;
                }

                Rectangle {
                  height: 18px;
                  width: 30px;
                  border-radius: 9px;
                  background: Palette.foreground.with-alpha(0.08);

                  Text {
                    width: 100%;
                    height: 100%;
                    text: group.versions.length;
                    color: Palette.foreground.with-alpha(0.55);
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                  }
                }
              }

              header-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                  collapsed = !collapsed;
                }
              }
            }

            if !collapsed : VerticalLayout {
              for version in group.versions : ProjectVersionRow {
                title: version.name;
                loaders: version.loaders;
                channel: version.channel;
                file-name: version.file-name;
                file-size: version.size;
                downloadable: version.downloadable;
                busy: AppState.downloading-version != "";
                active: AppState.downloading-version == version.key;
                download => {
                  Actions.download-version(version.key);
                }
              }
            }
          }
        }

        if AppState.project-version-groups.length == 0 : EmptyHint {
          text: AppState.project-versions-loading
            ? "正在获取版本列表…"
            : "这个项目没有可下载的版本";
        }
      }
    }
  }
}
