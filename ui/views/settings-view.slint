import { LineEdit, ListView, Palette } from "std-widgets.slint";
import { ActionButton, Tag } from "../components/common.slint";
import { SettingsSection, ThemePreference } from "../models/enums.slint";
import { JavaInfo } from "../models/java.slint";
import { AppState } from "../state/app-state.slint";
import { Actions } from "../state/actions.slint";
import { Theme } from "../theme/theme.slint";

component SettingsMenuItem inherits Rectangle {
  in property <string> label;
  in property <image> icon;
  in property <bool> selected;

  callback clicked();

  height: 40px;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.14)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 8px;
    cross-axis-alignment: center;

    Image {
      source: root.icon;
      width: 16px;
      height: 16px;
      colorize: Palette.foreground.with-alpha(0.72);
    }

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 13px;
      font-weight: root.selected ? 600 : 400;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component SettingsPanel inherits Rectangle {
  in property <string> title;
  in property <string> subtitle;

  background: transparent;

  VerticalLayout {
    padding: 24px;
    spacing: 8px;

    Text {
      text: root.title;
      color: Palette.foreground;
      font-size: 24px;
      font-weight: 600;
    }

    Text {
      text: root.subtitle;
      color: Palette.foreground.with-alpha(0.65);
      font-size: 14px;
    }

    Rectangle {
      height: 1px;
      background: Palette.foreground.with-alpha(0.08);
    }

    Rectangle {
      vertical-stretch: 1;
    }

    Text {
      text: "设置项将在这里展示";
      color: Palette.foreground.with-alpha(0.45);
      font-size: 14px;
      horizontal-alignment: center;
    }

    Rectangle {
      vertical-stretch: 1;
    }
  }
}

component GamePanel inherits Rectangle {
  background: transparent;

  VerticalLayout {
    padding: 16px;
    spacing: 8px;

    Text {
      text: "游戏目录";
      color: Palette.foreground;
      font-size: 14px;
      font-weight: 600;
    }

    Rectangle {
      height: 64px;
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);

      HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        VerticalLayout {
          horizontal-stretch: 1;
          alignment: center;
          spacing: 2px;

          Text {
            text: "官方启动文件夹";
            color: Palette.foreground;
            font-size: 13px;
            font-weight: 600;
          }

          Text {
            text: AppState.game-dir;
            color: Palette.foreground.with-alpha(0.55);
            font-size: 11px;
            overflow: elide;
          }
        }

        Rectangle {
          width: 34px;
          height: 34px;
          border-radius: 6px;
          background: open-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

          Image {
            source: @image-url("../images/icons/folder2-open.svg");
            width: 18px;
            height: 18px;
            colorize: Palette.foreground.with-alpha(0.72);
          }

          open-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
              Actions.open-folder(AppState.game-dir);
            }
          }
        }
      }
    }

    Rectangle {
      vertical-stretch: 1;
    }
  }
}

component JavaCard inherits Rectangle {
  in property <JavaInfo> info;

  height: 92px;
  border-radius: 6px;
  background: Palette.background.with-alpha(0.5);
  border-width: 1px;
  border-color: Palette.foreground.with-alpha(0.08);

  HorizontalLayout {
    padding: 14px;
    spacing: 12px;
    cross-axis-alignment: center;

    VerticalLayout {
      horizontal-stretch: 1;
      alignment: center;
      spacing: 3px;

      HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;

        Text {
          text: "JDK " + root.info.version;
          color: Palette.foreground;
          font-size: 14px;
          font-weight: 600;
        }

        Tag {
          label: root.info.lts
            ? "Java \{root.info.major} (LTS)"
            : "Java \{root.info.major}";
        }

        Text {
          text: root.info.vendor;
          color: Palette.accent-background;
          font-size: 12px;
          horizontal-stretch: 1;
          overflow: elide;
          vertical-alignment: center;
        }
      }

      Text {
        text: root.info.path;
        color: Palette.foreground.with-alpha(0.5);
        font-size: 11px;
        overflow: elide;
      }
    }

    Rectangle {
      width: 34px;
      height: 34px;
      border-radius: 6px;
      background: folder-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

      Image {
        source: @image-url("../images/icons/folder2-open.svg");
        width: 18px;
        height: 18px;
        colorize: Palette.foreground.with-alpha(0.72);
      }

      folder-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
          Actions.open-folder(root.info.path);
        }
      }
    }
  }
}

component JavaPanel inherits Rectangle {
  background: transparent;

  VerticalLayout {
    padding: 16px;
    spacing: 10px;

    if AppState.java-info.path != "" : JavaCard {
      info: AppState.java-info;
    }

    if AppState.java-info.path == "" : Rectangle {
      height: 92px;
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);

      Text {
        text: "未检测到 Java，请安装 JDK 或设置 JAVA_HOME。";
        color: Palette.foreground.with-alpha(0.55);
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
      }
    }

    Rectangle {
      vertical-stretch: 1;
    }
  }
}

component ThemeOption inherits Rectangle {
  in property <string> label;
  in property <bool> selected;

  callback clicked();

  height: 30px;
  min-width: 72px;
  horizontal-stretch: 0;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.14)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;

  HorizontalLayout {
    padding-left: 10px;
    padding-right: 10px;
    alignment: center;
    cross-axis-alignment: center;

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 12px;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

// 设置页按钮：沿用 common 的实现，只覆盖高度
component SettingsButton inherits ActionButton {
  button-height: 30px;
}

component ToggleSwitch inherits Rectangle {
  in property <bool> checked;

  callback toggled();

  width: 40px;
  height: 22px;
  horizontal-stretch: 0;
  border-radius: 11px;
  background: root.checked
    ? Palette.accent-background
    : Palette.foreground.with-alpha(0.18);

  Rectangle {
    width: 18px;
    height: 18px;
    y: 2px;
    x: root.checked ? root.width - 20px : 2px;
    border-radius: 9px;
    background: #ffffff;
    animate x { duration: 150ms; easing: ease-in-out; }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.toggled();
    }
  }
}

component ColorSwatch inherits Rectangle {
  in property <color> swatch;
  in property <bool> selected;

  callback clicked();

  width: 30px;
  height: 30px;
  border-radius: 6px;
  background: root.swatch;
  border-width: root.selected ? 2px : 1px;
  border-color: root.selected
    ? Palette.foreground
    : Palette.foreground.with-alpha(0.15);

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component WallpaperRow inherits Rectangle {
  in property <string> wallpaper-path;
  in property <string> wallpaper-name;
  in property <image> thumbnail;
  in property <bool> has-thumbnail;
  in property <bool> selected;

  callback select();
  callback remove();

  height: 76px;
  background: transparent;

  card := Rectangle {
    height: 68px;
    y: 4px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected
      ? Palette.accent-background.with-alpha(0.75)
      : Palette.foreground.with-alpha(0.08);
    background: root.selected
      ? Palette.accent-background.with-alpha(0.12)
      : Palette.background.with-alpha(0.35);

    select-touch := TouchArea {
      mouse-cursor: pointer;
      clicked => {
        root.select();
      }
    }

    HorizontalLayout {
      padding: 7px;
      spacing: 10px;
      cross-axis-alignment: center;

      Rectangle {
        width: 88px;
        height: 50px;
        border-radius: 4px;
        clip: true;
        background: Palette.foreground.with-alpha(0.05);

        if root.has-thumbnail : Image {
          source: root.thumbnail;
          width: 100%;
          height: 100%;
          image-fit: cover;
        }

        if !root.has-thumbnail : Image {
          source: @image-url("../images/icons/images.svg");
          width: 18px;
          height: 18px;
          colorize: Palette.foreground.with-alpha(0.35);
        }
      }

      VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        HorizontalLayout {
          spacing: 6px;
          cross-axis-alignment: center;

          Text {
            text: root.wallpaper-name;
            color: Palette.foreground;
            font-size: 13px;
            font-weight: 600;
            horizontal-stretch: 1;
            overflow: elide;
          }

          if root.selected : Rectangle {
            height: 18px;
            min-width: 34px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: Palette.accent-background.with-alpha(0.18);

            HorizontalLayout {
              padding-left: 6px;
              padding-right: 6px;
              alignment: center;
              cross-axis-alignment: center;

              Text {
                text: "当前";
                color: Palette.accent-background;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
              }
            }
          }
        }

        Text {
          text: root.wallpaper-path;
          color: Palette.foreground.with-alpha(0.45);
          font-size: 11px;
          overflow: elide;
        }
      }

      Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: remove-touch.has-hover ? #c0392b22 : transparent;

        Image {
          source: @image-url("../images/icons/trash.svg");
          width: 15px;
          height: 15px;
          colorize: remove-touch.has-hover
            ? #c0392b
            : Palette.foreground.with-alpha(0.42);
        }

        remove-touch := TouchArea {
          mouse-cursor: pointer;
          clicked => {
            root.remove();
          }
        }
      }
    }
  }
}

component AppearancePanel inherits Rectangle {
  in-out property <string> wallpaper-message: "";
  in-out property <string> color-input: "";
  in property <[color]> palette: [
    #0F1115,
    #1E293B,
    #1E3A8A,
    #0E7490,
    #047857,
    #4D7C0F,
    #B45309,
    #B91C1C,
    #9D174D,
    #6D28D9,
    #E2E8F0,
    #F8FAFC
  ];

  init => {
    root.color-input = AppState.wallpaper-color-hex;
  }

  background: transparent;

  VerticalLayout {
    padding: 16px;
    spacing: 8px;

    Text {
      text: "主题";
      color: Palette.foreground;
      font-size: 14px;
      font-weight: 600;
    }

    Rectangle {
      height: 44px;
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);

      HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        Text {
          text: "颜色模式";
          color: Palette.foreground;
          font-size: 13px;
          horizontal-stretch: 1;
          vertical-alignment: center;
        }

        HorizontalLayout {
          spacing: 4px;

          ThemeOption {
            label: "跟随系统";
            selected: Theme.preference == ThemePreference.system;
            clicked => {
              root.set-theme(ThemePreference.system);
            }
          }

          ThemeOption {
            label: "深色";
            selected: Theme.preference == ThemePreference.dark;
            clicked => {
              root.set-theme(ThemePreference.dark);
            }
          }

          ThemeOption {
            label: "浅色";
            selected: Theme.preference == ThemePreference.light;
            clicked => {
              root.set-theme(ThemePreference.light);
            }
          }
        }
      }
    }

    HorizontalLayout {
      spacing: 8px;
      cross-axis-alignment: center;

      Text {
        text: "背景";
        color: Palette.foreground;
        font-size: 14px;
        font-weight: 600;
        horizontal-stretch: 1;
        vertical-alignment: center;
      }

      ThemeOption {
        label: "图片";
        selected: !AppState.background-is-color;
        clicked => {
          root.wallpaper-message = Actions.choose-background-mode("image");
        }
      }

      ThemeOption {
        label: "纯色";
        selected: AppState.background-is-color;
        clicked => {
          root.wallpaper-message = Actions.choose-background-mode("color");
          root.color-input = AppState.wallpaper-color-hex;
        }
      }
    }

    if root.wallpaper-message != "" : Text {
      text: root.wallpaper-message;
      color: #e5484d;
      font-size: 12px;
      overflow: elide;
    }

    if !AppState.background-is-color : VerticalLayout {
      vertical-stretch: 1;
      spacing: 8px;

      Rectangle {
        height: 88px;
        border-radius: 6px;
        background: Palette.background.with-alpha(0.5);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        HorizontalLayout {
          padding: 10px;
          spacing: 12px;
          cross-axis-alignment: center;

          Rectangle {
            width: 112px;
            height: 68px;
            border-radius: 6px;
            clip: true;

            Image {
              source: AppState.wallpaper;
              width: 100%;
              height: 100%;
              image-fit: cover;
            }
          }

          VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
              text: "当前背景";
              color: Palette.foreground.with-alpha(0.65);
              font-size: 12px;
            }

            Text {
              text: AppState.background-name;
              color: Palette.foreground;
              font-size: 13px;
              font-weight: 600;
              overflow: elide;
            }

            Text {
              text: "支持 PNG / JPG，可多选";
              color: Palette.foreground.with-alpha(0.45);
              font-size: 11px;
            }
          }

          SettingsButton {
            label: "添加图片";
            primary: true;
            clicked => {
              root.wallpaper-message = Actions.choose-custom-wallpaper();
            }
          }

          SettingsButton {
            label: "恢复默认";
            clicked => {
              root.wallpaper-message = Actions.reset-wallpaper();
            }
          }
        }
      }

      HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        Text {
          text: "已选壁纸";
          color: Palette.foreground;
          font-size: 14px;
          font-weight: 600;
        }

        Text {
          text: "\{AppState.wallpapers.length} 张";
          color: Palette.foreground.with-alpha(0.5);
          font-size: 12px;
          vertical-alignment: center;
        }

        Rectangle {
          horizontal-stretch: 1;
        }

        Text {
          text: "随机选择";
          color: Palette.foreground.with-alpha(0.75);
          font-size: 12px;
          vertical-alignment: center;
        }

        ToggleSwitch {
          checked: AppState.wallpaper-random;
          toggled => {
            root.wallpaper-message = Actions.set-wallpaper-random(!AppState.wallpaper-random);
          }
        }
      }

      if AppState.wallpaper-random && AppState.wallpapers.length > 0 : Text {
        text: "每次启动会从已选壁纸中随机挑一张";
        color: Palette.foreground.with-alpha(0.5);
        font-size: 11px;
      }

      if AppState.wallpapers.length == 0 : Rectangle {
        height: 64px;
        border-radius: 6px;
        background: Palette.background.with-alpha(0.35);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        Text {
          text: "还没有添加自定义壁纸";
          color: Palette.foreground.with-alpha(0.45);
          font-size: 12px;
          horizontal-alignment: center;
          vertical-alignment: center;
        }
      }

      if AppState.wallpapers.length > 0 : ListView {
        vertical-stretch: 1;
        min-height: 140px;

        for wallpaper in AppState.wallpapers : WallpaperRow {
          wallpaper-path: wallpaper.path;
          wallpaper-name: wallpaper.name;
          thumbnail: wallpaper.thumbnail;
          has-thumbnail: wallpaper.has-thumbnail;
          selected: wallpaper.selected;

          select => {
            root.wallpaper-message = Actions.select-wallpaper(wallpaper.path);
          }

          remove => {
            root.wallpaper-message = Actions.remove-wallpaper(wallpaper.path);
          }
        }
      }
    }

    if AppState.background-is-color : VerticalLayout {
      spacing: 8px;

      Rectangle {
        height: 88px;
        border-radius: 6px;
        background: Palette.background.with-alpha(0.5);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        HorizontalLayout {
          padding: 10px;
          spacing: 12px;
          cross-axis-alignment: center;

          Rectangle {
            width: 112px;
            height: 68px;
            border-radius: 6px;
            background: AppState.wallpaper-color;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.15);
          }

          VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
              text: "当前背景";
              color: Palette.foreground.with-alpha(0.65);
              font-size: 12px;
            }

            Text {
              text: "纯色 " + AppState.wallpaper-color-hex;
              color: Palette.foreground;
              font-size: 13px;
              font-weight: 600;
            }

            Text {
              text: "点击下方色块，或输入自定义 HEX";
              color: Palette.foreground.with-alpha(0.45);
              font-size: 11px;
            }
          }

          SettingsButton {
            label: "恢复默认";
            clicked => {
              root.wallpaper-message = Actions.reset-wallpaper();
            }
          }
        }
      }

      Text {
        text: "调色板";
        color: Palette.foreground;
        font-size: 14px;
        font-weight: 600;
      }

      Rectangle {
        height: 54px;
        border-radius: 6px;
        background: Palette.background.with-alpha(0.35);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        FlexboxLayout {
          padding: 10px;
          spacing: 8px;

          for swatch in root.palette : ColorSwatch {
            swatch: swatch;
            selected: swatch == AppState.wallpaper-color;

            clicked => {
              root.pick-color(swatch);
            }
          }
        }
      }

      Rectangle {
        height: 40px;
        border-radius: 6px;
        background: Palette.background.with-alpha(0.5);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        HorizontalLayout {
          padding-left: 12px;
          padding-right: 6px;
          spacing: 8px;
          cross-axis-alignment: center;

          Text {
            text: "自定义颜色";
            color: Palette.foreground;
            font-size: 12px;
            vertical-alignment: center;
          }

          LineEdit {
            text <=> root.color-input;
            placeholder-text: "#RRGGBB";
            horizontal-stretch: 1;
            height: 28px;
          }

          SettingsButton {
            label: "应用";
            primary: true;
            clicked => {
              root.apply-color();
            }
          }
        }
      }

      Text {
        text: "支持 #RGB / #RRGGBB，例如 #1E3A8A";
        color: Palette.foreground.with-alpha(0.45);
        font-size: 11px;
      }

      Rectangle {
        vertical-stretch: 1;
      }
    }
  }

  function set-theme(preference: ThemePreference) {
    Theme.preference = preference;
    Theme.apply();
    Actions.save-theme-preference(
      preference == ThemePreference.system
        ? "system"
        : preference == ThemePreference.dark
          ? "dark"
          : "light"
    );
  }

  function apply-color() {
    root.wallpaper-message = Actions.set-wallpaper-color(root.color-input);
    if (root.wallpaper-message == "") {
      root.color-input = AppState.wallpaper-color-hex;
    }
  }

  function pick-color(value: color) {
    root.wallpaper-message = Actions.pick-wallpaper-color(value);
    if (root.wallpaper-message == "") {
      root.color-input = AppState.wallpaper-color-hex;
    }
  }
}

component HelpLinkRow inherits Rectangle {
  in property <string> title;
  in property <string> description;
  in property <string> url;

  height: 56px;
  border-radius: 6px;
  background: row-touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;

  row-touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      Actions.open-url(root.url);
    }
  }

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 8px;
    spacing: 8px;
    cross-axis-alignment: center;

    VerticalLayout {
      horizontal-stretch: 1;
      alignment: center;
      spacing: 2px;

      Text {
        text: root.title;
        color: Palette.foreground;
        font-size: 13px;
        font-weight: 600;
      }

      Text {
        text: root.description;
        color: Palette.foreground.with-alpha(0.6);
        font-size: 12px;
        overflow: elide;
      }
    }

    Rectangle {
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: open-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

      Image {
        source: @image-url("../images/icons/box-arrow-up-right.svg");
        width: 16px;
        height: 16px;
        colorize: Palette.foreground.with-alpha(0.72);
      }

      open-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
          Actions.open-url(root.url);
        }
      }
    }
  }
}

component DocsPanel inherits Rectangle {
  background: transparent;

  VerticalLayout {
    padding: 16px;
    spacing: 8px;

    Text {
      text: "Minecraft";
      color: Palette.foreground;
      font-size: 14px;
      font-weight: 600;
    }

    Rectangle {
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);

      VerticalLayout {
        padding: 6px;
        spacing: 2px;

        HelpLinkRow {
          title: "Minecraft 官网";
          description: "官方游戏资讯、下载与购买入口";
          url: "https://www.minecraft.net/";
        }

        HelpLinkRow {
          title: "Minecraft Wiki";
          description: "方块、合成、机制与版本资料";
          url: "https://minecraft.wiki/";
        }

        HelpLinkRow {
          title: "Modrinth";
          description: "模组、整合包、资源包与光影";
          url: "https://modrinth.com/";
        }

        HelpLinkRow {
          title: "CurseForge";
          description: "大型模组与整合包社区";
          url: "https://www.curseforge.com/minecraft";
        }

        HelpLinkRow {
          title: "Fabric";
          description: "轻量级模组加载器与开发文档";
          url: "https://fabricmc.net/";
        }

        HelpLinkRow {
          title: "NeoForge";
          description: "新一代 Forge 生态模组加载器";
          url: "https://neoforged.net/";
        }
      }
    }

    Rectangle {
      vertical-stretch: 1;
    }
  }
}

component AboutPanel inherits Rectangle {
  background: transparent;

    VerticalLayout {
      padding: 16px;
      spacing: 8px;

      Text {
        text: "关于";
        color: Palette.foreground;
        font-size: 14px;
        font-weight: 600;
      }

      Rectangle {
        border-radius: 6px;
        background: Palette.background.with-alpha(0.5);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        VerticalLayout {
          padding: 6px;
          spacing: 2px;
          alignment: center;

          HelpLinkRow {
            title: "在 Github 查看源代码";
            url: "https://github.com/NeutrinoMCL/Neutrino-Minecraft-Launcher";
          }

          HelpLinkRow {
            title: "开发者名单";
            description: "查看所有为 Neutrino 做出贡献的开发者";
            url: "https://github.com/NeutrinoMCL/Neutrino-Minecraft-Launcher/graphs/contributors?all=1&selectedMetric=commits";
          }
        }
      }

      Text {
        text: "致谢";
        color: Palette.foreground;
        font-size: 14px;
        font-weight: 600;
      }

      Rectangle {
        border-radius: 6px;
        background: Palette.background.with-alpha(0.5);
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.08);

        VerticalLayout {
          padding: 6px;
          spacing: 2px;
          alignment: center;

          HelpLinkRow {
            title: "汉仪字库字体设计团队";
            description: "设计的 HarmonyOS Sans SC 字体";
            url: "https://developer.huawei.com/consumer/cn/design/resource-V1/";
          }
        }
      }

      Rectangle {
        vertical-stretch: 1;
      }
    }
}

export component SettingsView inherits Rectangle {
  in-out property <SettingsSection> current-section: SettingsSection.game;

  background: transparent;

  HorizontalLayout {
    padding: 16px;
    spacing: 16px;

    VerticalLayout {
      width: 200px;
      horizontal-stretch: 0;
      padding-top: 8px;
      padding-bottom: 8px;
      spacing: 4px;

      SettingsMenuItem {
        label: "全局游戏设置";
        icon: @image-url("../images/icons/game.svg");
        selected: root.current-section == SettingsSection.game;
        clicked => {
          root.current-section = SettingsSection.game;
        }
      }

      SettingsMenuItem {
        label: "Java";
        icon: @image-url("../images/icons/java.svg");
        selected: root.current-section == SettingsSection.java;
        clicked => {
          root.current-section = SettingsSection.java;
        }
      }

      SettingsMenuItem {
        label: "通用";
        icon: @image-url("../images/icons/setting.svg");
        selected: root.current-section == SettingsSection.general;
        clicked => {
          root.current-section = SettingsSection.general;
        }
      }

      SettingsMenuItem {
        label: "外观";
        icon: @image-url("../images/icons/palette.svg");
        selected: root.current-section == SettingsSection.appearance;
        clicked => {
          root.current-section = SettingsSection.appearance;
        }
      }

      SettingsMenuItem {
        label: "下载资源";
        icon: @image-url("../images/icons/cloud-download.svg");
        selected: root.current-section == SettingsSection.downloads;
        clicked => {
          root.current-section = SettingsSection.downloads;
        }
      }

      SettingsMenuItem {
        label: "文档与帮助";
        icon: @image-url("../images/icons/question-circle.svg");
        selected: root.current-section == SettingsSection.docs;
        clicked => {
          root.current-section = SettingsSection.docs;
        }
      }

      SettingsMenuItem {
        label: "关于";
        icon: @image-url("../images/icons/exclamation-circle.svg");
        selected: root.current-section == SettingsSection.about;
        clicked => {
          root.current-section = SettingsSection.about;
        }
      }
    }

    Rectangle {
      horizontal-stretch: 1;
      background: transparent;

      if root.current-section == SettingsSection.game : GamePanel { }

      if root.current-section == SettingsSection.java : JavaPanel { }

      if root.current-section == SettingsSection.general : SettingsPanel {
        title: "通用";
      }

      if root.current-section == SettingsSection.appearance : AppearancePanel { }

      if root.current-section == SettingsSection.downloads : SettingsPanel {
        title: "下载资源";
      }

      if root.current-section == SettingsSection.docs : DocsPanel { }

      if root.current-section == SettingsSection.about : AboutPanel { }
    }
  }
}
