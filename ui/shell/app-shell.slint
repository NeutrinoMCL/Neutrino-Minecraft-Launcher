import { Palette } from "std-widgets.slint";
import { Page } from "../models/enums.slint";
import { AppState } from "../state/app-state.slint";
import { TopBar } from "top-bar.slint";
import { LaunchView } from "../views/launch-view.slint";
import { InstancesView } from "../views/instances-view.slint";
import { AccountView } from "../views/account-view.slint";
import { DiscoverView } from "../views/discover-view.slint";
import { SettingsView } from "../views/settings-view.slint";

export component AppShell inherits Rectangle {
  in-out property <Page> current-page: Page.launch;

  callback navigate(Page);

  background: #0f1115;

  Image {
    source: AppState.wallpaper;
    width: 100%;
    height: 100%;
    image-fit: cover;
    visible: !AppState.background-is-color;
    accessible-role: none;
  }

  Rectangle {
    width: 100%;
    height: 100%;
    background: AppState.wallpaper-color;
    visible: AppState.background-is-color;
  }

  Rectangle {
    width: 100%;
    height: 100%;
    background: @linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.5) 100%);
  }

  VerticalLayout {
    TopBar {
      current-page: root.current-page;

      navigate(page) => {
        root.current-page = page;
        root.navigate(page);
      }
    }

    Rectangle {
      vertical-stretch: 1;

      LaunchView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        visible: root.current-page == Page.launch;
      }

      HorizontalLayout {
        visible: root.current-page != Page.launch;
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 16px;

        Rectangle {
          horizontal-stretch: 1;
          vertical-stretch: 1;
          border-radius: 6px;
          background: Palette.background.with-alpha(0.9);
          border-width: 1px;
          border-color: Palette.foreground.with-alpha(0.08);
          clip: true;

          InstancesView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            visible: root.current-page == Page.instances;
          }

          AccountView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            visible: root.current-page == Page.account;
          }

          DiscoverView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            visible: root.current-page == Page.discover;
          }

          SettingsView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            visible: root.current-page == Page.settings;
          }
        }
      }
    }
  }
}
