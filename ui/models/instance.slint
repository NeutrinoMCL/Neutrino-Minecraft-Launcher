export struct InstanceInfo {
  name: string,
  path: string
}

export struct ContentFile {
  name: string,
  size: int,
  enabled: bool,
  /// 从 jar / 资源包中读出的图标（没有时为空，用通用图标兜底）
  icon: image,
  has-icon: bool,
  /// 模组版本（资源包 / 光影为空）
  version: string,
  /// 模组加载器：Fabric / Quilt / Forge / NeoForge（没有时为空）
  loader: string
}

/// 可更新的实例内容
export struct ContentUpdateInfo {
  key: string,
  name: string,
  current-version: string,
  new-version: string,
  source: string,
  file-name: string,
  size: string
}
