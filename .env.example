# Microsoft Entra App Registration client ID.
# This is a public identifier, not a client secret.
# For CI/release builds, set the same value as a GitHub Actions repository variable.
NEUTRINO_MSA_CLIENT_ID=your-client-id-here

# CurseForge API key (required only for the CurseForge download source).
# Create one at https://console.curseforge.com/ and paste it here.
# The value is read literally, so keys containing `$` are safe.
# NEUTRINO_CURSEFORGE_API_KEY is accepted as a legacy alias.
CURSEFORGE_API_KEY=your-curseforge-api-key-here
